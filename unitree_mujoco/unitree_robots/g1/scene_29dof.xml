<mujoco model="g1_29dof scene">
  <include file="g1_29dof.xml"/>

  <statistic center="0 0 0.5" extent="2.0"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="-130" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>

    <!-- Vision-validation test photo. MuJoCo 3.5's built-in texture loader
         is PNG-only — convert any JPG with cv2.imwrite or `convert in.jpg
         out.png` first. Path is relative to this MJCF. -->
    <texture type="2d" name="test_photo" file="images/mygo_cover.png"/>
    <material name="test_photo" texture="test_photo" texuniform="false" rgba="1 1 1 1"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <!--
      Floor with explicit friction + condim=6 + priority=1.
      Default MuJoCo friction is "1 0.005 0.0001" (sliding, torsional, rolling)
      and condim=3 (no torsional friction in the contact). Combined with this
      MJCF's foot geoms — 4 small spheres of size=0.005 with no friction or
      priority override — the resulting contact has a tiny patch and zero
      torsional grip, so when the policy commands a heel-strike the foot
      can pivot freely around the contact axis. That is the "walking feels
      slightly slippery / scuffing" symptom in QA5.
      Setting priority=1 here (and friction sliding=1.5, torsional=0.05,
      rolling=0.005) makes the floor's friction values dominate the contact
      pair and gives the contact full friction degrees of freedom. Numbers
      match the upper end of the friction randomization used during training
      (`unitree_rl_mjlab/.../scene_g1.xml` defaults plus dom-rand range).
    -->
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"
          friction="1.5 0.05 0.005" condim="6" priority="1"/>

    <!-- Test photo wall. 2 m in front of the robot (camera default fwd = +X),
         centred at z=1.24 m which is roughly the head-camera mount height.
         Visible size 1.5 m wide x 1.0 m tall (size= are half-extents).
         contype/conaffinity=0 -> no collisions, so it does not interfere
         with the locomotion policy. xyaxes orients the box so its front
         face (towards -X) carries the texture mapping cleanly. -->
    <geom name="test_photo_wall" type="box" pos="2.0 0 1.24"
          xyaxes="0 -1 0 0 0 1" size="0.75 0.5 0.02"
          material="test_photo" contype="0" conaffinity="0"/>
  </worldbody>
</mujoco>
